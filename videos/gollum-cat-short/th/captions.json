 },
 {
  "start": 1.69,
  "end": 1.98,
  "text": "เสียงของ"
 },
 {
  "start": 1.98,
  "end": 2.57,
  "text": "ตัวละครตัวนี้"
 },
 {
  "start": 2.57,
  "end": 3.28,
  "text": "มาจากแมว"
 },
 {
  "start": 3.28,
  "end": 3.67,
  "text": "ที่กำลัง"
 },
 {
  "start": 3.67,
  "end": 4.603,
  "text": "สำลักก้อนขน"
 },
 {
  "start": 4.603,
  "end": 5.3,
  "text": "ตัวละครตัวนี้"
 },
 {
  "start": 5.3,
  "end": 5.95,
  "text": "ชื่อ Gollum"
 },
 {
  "start": 5.95,
  "end": 6.703,
  "text": "สิ่งมีชีวิต"
 },
 {
  "start": 6.703,
  "end": 7.15,
  "text": "ผอมแห้ง"
 },
 {
  "start": 7.15,
  "end": 7.76,
  "text": "ที่หลงใหล"
 },
 {
  "start": 7.76,
  "end": 8.31,
  "text": "แหวนวิเศษ"
 },
 {
  "start": 8.31,
  "end": 9.259,
  "text": "จนเสียสติ"
 },
 {
  "start": 9.259,
  "end": 9.71,
  "text": "นักแสดง"
 },
 {
  "start": 9.71,
  "end": 10.14,
  "text": "ต้องคิด"
 },
 {
  "start": 10.14,
  "end": 10.68,
  "text": "เสียงของมัน"
 },
 {
  "start": 10.68,
  "end": 11.43,
  "text": "ขึ้นมาเอง"
 },
 {
  "start": 11.43,
  "end": 11.84,
  "text": "เขาลอง"
 },
 {
  "start": 11.84,
  "end": 12.44,
  "text": "มาหลายแบบ"
 },
 {
  "start": 12.44,
  "end": 13.169,
  "text": "ไม่มีเสียง"
 },
 {
  "start": 13.169,
  "end": 14.077,
  "text": "ไหนใช่เลย"
 },
 {
  "start": 14.077,
  "end": 14.457,
  "text": "แต่แล้ว"
 },
 {
  "start": 14.457,
  "end": 14.9,
  "text": "วันหนึ่ง"
 },
 {
  "start": 14.9,
  "end": 15.44,
  "text": "แมวของเขา"
 },
 {
  "start": 15.44,
  "end": 15.9,
  "text": "ก็ทำ"
 },
 {
  "start": 15.9,
  "end": 16.317,
  "text": "บางอย่าง"
 },
 {
  "start": 16.317,
  "end": 17.042,
  "text": "ขึ้นมา"
 },
 {
  "start": 17.042,
  "end": 17.55,
  "text": "มันสำรอก"
 },
 {
  "start": 17.55,
  "end": 17.99,
  "text": "ก้อนขน"
 },
 {
  "start": 17.99,
  "end": 18.96,
  "text": "ออกมาต่อหน้าเขา"
 },
 {
  "start": 18.96,
  "end": 19.46,
  "text": "เสียงแหบๆ"
 },
 {
  "start": 19.46,
  "end": 20.02,
  "text": "ที่ดังออกมา"
 },
 {
  "start": 20.02,
  "end": 20.64,
  "text": "จากลำคอ"
 },
 {
  "start": 20.64,
  "end": 21.25,
  "text": "ตอนนั้น"
 },
 {
  "start": 21.25,
  "end": 21.51,
  "text": "คือเสียง"
 },
 {
  "start": 21.51,
  "end": 22.12,
  "text": "ที่เขาใช้"
 },
 {
  "start": 22.12,
  "end": 22.69,
  "text": "เป็นต้นแบบ"
 },
 {
  "start": 22.69,
  "end": 23.507,
