[
 {
  "start": 0.0,
  "end": 0.65,
  "text": "เป็นไปได้ไง"
 },
 {
  "start": 0.65,
  "end": 1.45,
  "text": "นักแสดงคนนี้"
 },
 {
  "start": 1.45,
  "end": 2.31,
  "text": "รู้ความลับสุดท้าย"
 },
 {
  "start": 2.31,
  "end": 3.37,
  "text": "ของ Harry Potter"
 },
 {
  "start": 3.37,
  "end": 4.31,
  "text": "ก่อนคนดูหนัง"
 },
 {
  "start": 4.31,
  "end": 4.76,
  "text": "ทั้งโลก"
 },
 {
  "start": 4.76,
  "end": 5.96,
  "text": "เกือบ 10ปี!"
 },
 {
  "start": 5.96,
  "end": 6.42,
  "text": "ตอนถ่าย"
 },
 {
  "start": 6.42,
  "end": 7.2,
  "text": "Harry Potter"
 },
 {
  "start": 7.2,
  "end": 7.48,
  "text": "ภาคแรก"
 },
 {
  "start": 7.48,
  "end": 8.39,
  "text": "Alan Rickman"
 },
 {
  "start": 8.39,
  "end": 9.23,
  "text": "ที่เล่นเป็นสเนป"
 },
 {
  "start": 9.23,
  "end": 9.99,
  "text": "อยากเข้าใจ"
 },
 {
  "start": 9.99,
  "end": 10.63,
  "text": "ตัวละคร"
 },
 {
  "start": 10.63,
  "end": 11.16,
  "text": "ให้ลึกซึ้ง"
 },
 {
  "start": 11.16,
  "end": 12.19,
  "text": "ที่สุด"
 },
 {
  "start": 12.19,
  "end": 12.73,
  "text": "เพราะสเนป"
 },
 {
  "start": 12.73,
  "end": 13.43,
  "text": "ดูเป็นคนร้าย"
 },
 {
  "start": 13.43,
  "end": 14.28,
  "text": "ที่เกลียดแฮร์รี่"
 },
 {
  "start": 14.28,
  "end": 14.94,
  "text": "ตลอดทั้งเรื่อง"
 },
 {
  "start": 14.94,
  "end": 16.13,
  "text": "J.K. Rowling"
 },
 {
  "start": 16.13,
  "end": 17.05,
  "text": "เลยบอกความลับ"
 },
 {
  "start": 17.05,
  "end": 17.32,
  "text": "ข้อหนึ่ง"
 },
 {
  "start": 17.32,
  "end": 18.43,
  "text": "ให้เขารู้คนเดียว"
 },
 {
  "start": 18.43,
  "end": 19.4,
  "text": "และขอให้เขา"
 },
 {
  "start": 19.4,
  "end": 19.93,
  "text": "เก็บไว้"
 },
 {
  "start": 19.93,
  "end": 20.914,
  "text": "ไม่บอกใคร"
 },
 {
  "start": 20.914,
  "end": 21.84,
  "text": "แต่ความลับนั้น"
 },
 {
  "start": 21.84,
  "end": 22.534,
  "text": "คือเหตุผล"
 },
 {
  "start": 22.534,
  "end": 23.29,
  "text": "ที่สเนป"
 },
 {
  "start": 23.29,
  "end": 23.9,
  "text": "คอยปกป้อง"
 },
 {
  "start": 23.9,
  "end": 24.344,
  "text": "แฮร์รี่"
 },
 {
  "start": 24.344,
  "end": 25.288,
  "text": "มาตลอด!"
 },
 {
  "start": 25.288,
  "end": 25.77,
  "text": "เขาเก็บ"
 },
 {
  "start": 25.77,
  "end": 26.37,
  "text": "ความลับนี้"
 },
 {
  "start": 26.37,
  "end": 26.93,
  "text": "มาหลายปี"
 },
 {
  "start": 26.93,
  "end": 27.43,
  "text": "แม้แต่"
 },
 {
  "start": 27.43,
  "end": 27.93,
  "text": "ผู้กำกับ"
 },
 {
  "start": 27.93,
  "end": 28.55,
  "text": "ยังไม่รู้"
 },
 {
  "start": 28.55,
  "end": 29.22,
  "text": "เวลามีคน"
 },
 {
  "start": 29.22,
  "end": 29.74,
  "text": "ขอให้เขา"
 },
 {
  "start": 29.74,
  "end": 30.46,
  "text": "เล่นแบบอื่น"
 },
 {
  "start": 30.46,
  "end": 31.468,
  "text": "เขาจะตอบว่า"
 },
 {
  "start": 31.468,
  "end": 31.86,
  "text": "ผมรู้"
 },
 {
  "start": 31.86,
  "end": 32.26,
  "text": "บางอย่าง"
 },
 {
  "start": 32.26,
  "end": 33.29,
  "text": "ที่คุณไม่รู้"
 },
 {
  "start": 33.29,
  "end": 33.828,
  "text": "ที่พีคคือ"
 },
 {
  "start": 33.828,
  "end": 35.2,
  "text": "คนดูทั้งโลกเพิ่งได้รู้"
 },
 {
  "start": 35.2,
  "end": 35.57,
  "text": "ความลับนี้"
 },
 {
  "start": 35.57,
  "end": 36.48,
  "text": "ตอนภาคสุดท้าย"
 },
 {
  "start": 36.48,
  "end": 38.301,
  "text": "ฉายในปี 2011!"
 }
]