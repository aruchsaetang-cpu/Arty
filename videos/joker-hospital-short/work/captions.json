[
 {
  "start": 0.0,
  "text": "รู้มั้ยว่าฉากที่",
  "end": 0.56
 },
 {
  "start": 0.56,
  "text": "Joker กดรีโมต",
  "end": 1.38
 },
 {
  "start": 1.38,
  "text": "แล้วตึกไม่ระเบิด",
  "end": 1.97
 },
 {
  "start": 1.97,
  "text": "ไม่ใช่อุบัติเหตุ",
  "end": 3.06
 },
 {
  "start": 3.06,
  "text": "ในหนัง Joker",
  "end": 3.56
 },
 {
  "start": 3.56,
  "text": "เดินออกมา",
  "end": 3.97
 },
 {
  "start": 3.97,
  "text": "จากโรงพยาบาล",
  "end": 4.67
 },
 {
  "start": 4.67,
  "text": "แล้วกดรีโมต",
  "end": 5.48
 },
 {
  "start": 5.48,
  "text": "ตึกไม่ระเบิดสักที",
  "end": 6.44
 },
 {
  "start": 6.44,
  "text": "เขาเลยกดซ้ำ",
  "end": 7.05
 },
 {
  "start": 7.05,
  "text": "คนดูเลยคิดว่า",
  "end": 7.69
 },
 {
  "start": 7.69,
  "text": "ระเบิดพัง",
  "end": 8.4
 },
 {
  "start": 8.4,
  "text": "แต่จริงๆผู้กำกับ",
  "end": 9.55
 },
 {
  "start": 9.55,
  "text": "ตั้งใจให้เป็นแบบนั้น",
  "end": 10.5
 },
 {
  "start": 10.5,
  "text": "เขาระเบิดตึกจริงๆ",
  "end": 11.34
 },
 {
  "start": 11.34,
  "text": "เลยต้องวางแผน",
  "end": 11.92
 },
 {
  "start": 11.92,
  "text": "ทุกอย่างไว้ก่อน",
  "end": 12.65
 },
 {
  "start": 12.65,
  "text": "ให้นักแสดง",
  "end": 13.48
 },
 {
  "start": 13.48,
  "text": "เดินออกมาทัน",
  "end": 13.9
 },
 {
  "start": 13.9,
  "text": "จะได้ไม่โดนอันตราย",
  "end": 15.01
 },
 {
  "start": 15.01,
  "text": "ที่พีคคือ",
  "end": 15.57
 },
 {
  "start": 15.57,
  "text": "คนดูทั่วโลก",
  "end": 16.3
 },
 {
  "start": 16.3,
  "text": "นึกว่าพัง",
  "end": 16.82
 },
 {
  "start": 16.82,
  "text": "ที่จริงมัน",
  "end": 17.33
 },
 {
  "start": 17.33,
  "text": "วางแผนไว้แล้ว",
  "end": 19.14
 }
