[
 {
  "start": 0.0,
  "end": 0.71,
  "text": "รู้มั้ยว่าฉากที่"
 },
 {
  "start": 0.71,
  "end": 1.48,
  "text": "Joker กดรีโมต"
 },
 {
  "start": 1.48,
  "end": 2.29,
  "text": "แล้วตึกไม่ระเบิด"
 },
 {
  "start": 2.29,
  "end": 3.1,
  "text": "ไม่ใช่อุบัติเหตุ"
 },
 {
  "start": 3.1,
  "end": 3.7,
  "text": "ในหนัง Joker"
 },
 {
  "start": 3.7,
  "end": 4.16,
  "text": "เดินออกมา"
 },
 {
  "start": 4.16,
  "end": 4.9,
  "text": "จากโรงพยาบาล"
 },
 {
  "start": 4.9,
  "end": 5.52,
  "text": "แล้วกดรีโมต"
 },
 {
  "start": 5.52,
  "end": 6.18,
  "text": "ตึกไม่ระเบิดสักที"
 },
 {
  "start": 6.18,
  "end": 6.82,
  "text": "เขาเลยกดซ้ำ"
 },
 {
  "start": 6.82,
  "end": 7.62,
  "text": "คนดูเลยคิดว่า"
 },
 {
  "start": 7.62,
  "end": 8.4,
  "text": "ระเบิดพัง"
 },
 {
  "start": 8.4,
  "end": 9.33,
  "text": "แต่จริงๆผู้กำกับ"
 },
 {
  "start": 9.33,
  "end": 10.5,
  "text": "ตั้งใจให้เป็นแบบนั้น"
 },
 {
  "start": 10.5,
  "end": 11.51,
  "text": "เขาระเบิดตึกจริงๆ"
 },
 {
  "start": 11.51,
  "end": 12.21,
  "text": "เลยต้องวางแผน"
 },
 {
  "start": 12.21,
  "end": 12.96,
  "text": "ทุกอย่างไว้ก่อน"
 },
 {
  "start": 12.96,
  "end": 13.48,
  "text": "ให้นักแสดง"
 },
 {
  "start": 13.48,
  "end": 14.32,
  "text": "เดินออกมาทัน"
 },
 {
  "start": 14.32,
  "end": 14.83,
  "text": "จะได้ไม่โดน"
 },
 {
  "start": 14.83,
  "end": 15.35,
  "text": "อันตราย"
 },
 {
  "start": 15.35,
  "end": 16.01,
  "text": "ที่พีคคือ"
 },
 {
  "start": 16.01,
  "end": 16.49,
  "text": "คนดูทั่วโลก"
 },
 {
  "start": 16.49,
  "end": 17.04,
  "text": "นึกว่าพัง"
 },
 {
  "start": 17.04,
  "end": 17.83,
  "text": "แต่ที่จริงมัน"
 },
 {
  "start": 17.83,
  "end": 19.14,
  "text": "วางแผนไว้แล้ว"
 }
]