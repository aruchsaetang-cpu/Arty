 },
 {
  "start": 9.95,
  "end": 10.26,
  "text": "ต้องเอามือ"
 },
 {
  "start": 10.26,
  "end": 10.92,
  "text": "สอดไว้ระหว่าง"
 },
 {
  "start": 10.92,
  "end": 11.46,
