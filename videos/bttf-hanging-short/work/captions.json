 },
 {
  "start": 4.96,
  "end": 5.56,
  "text": "จับแขวนคอ"
 },
 {
  "start": 5.56,
  "end": 5.86,
  "text": "ตอนแรก"
 },
 {
  "start": 5.86,
  "end": 6.22,
  "text": "ไมเคิล"
 },
 {
  "start": 6.22,
  "end": 6.76,
  "text": "มีกล่องให้ยืน"
 },
 {
  "start": 6.76,
  "end": 7.43,
  "text": "แต่ผู้กำกับ"
 },
 {
  "start": 7.43,
  "end": 8.1,
  "text": "อยากให้ภาพดู"
 },
 {
  "start": 8.1,
  "end": 8.91,
