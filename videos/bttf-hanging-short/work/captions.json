 },
 {
  "start": 20.08,
  "end": 20.6,
  "text": "กว่าผู้กำกับ"
 },
 {
  "start": 20.6,
  "end": 20.96,
  "text": "จะรู้ว่า"
 },
 {
  "start": 20.96,
  "end": 21.87,
  "text": "ไม่ใช่การแสดง"
 },
 {
  "start": 21.87,
  "end": 22.4,
  "text": "โชคดี"
 },
 {
  "start": 22.4,
  "end": 23.53,
  "text": "ที่ช่วยลงมาได้ทัน"
 },
 {
  "start": 23.53,
  "end": 24.0,
  "text": "และไมเคิล"
 },
 {
  "start": 24.0,
  "end": 24.6,
  "text": "เป็นคนเล่า"
 },
 {
  "start": 24.6,
  "end": 25.07,
  "text": "เรื่องนี้เอง"
 },
 {
  "start": 25.07,
  "end": 25.95,
  "text": "ในหนังสือ"
 },
 {
  "start": 25.95,
  "end": 26.54,
  "text": "ชีวประวัติ"
 },
 {
  "start": 26.54,
  "end": 26.97,
