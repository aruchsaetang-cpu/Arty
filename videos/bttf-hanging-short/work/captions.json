[
 {
  "start": 0.03,
  "end": 0.66,
  "text": "เพื่อนๆ รู้มั้ยว่า"
 },
 {
  "start": 0.66,
  "end": 1.01,
  "text": "ในหนัง"
 },
 {
  "start": 1.01,
  "end": 1.98,
  "text": "Back to the Future"
 },
 {
  "start": 1.98,
  "end": 2.46,
  "text": "ภาค 3"
 },
 {
  "start": 2.46,
  "end": 2.9,
  "text": "พระเอก"
 },
 {
  "start": 2.9,
  "end": 3.52,
  "text": "เกือบตายจริงๆ"
 },
 {
  "start": 3.52,
  "end": 4.12,
  "text": "ในฉากนี้"
 },
 {
  "start": 4.12,
  "end": 4.91,
  "text": "มาร์ตี้ถูก"
 },
 {
  "start": 4.91,
  "end": 5.45,
  "text": "พวกคาวบอย"
 },
 {
  "start": 5.45,
  "end": 6.41,
  "text": "จับแขวนคอ"
 },
 {
  "start": 6.41,
  "end": 6.78,
  "text": "ตอนแรก"
 },
 {
  "start": 6.78,
  "end": 7.39,
  "text": "ไมเคิล"
 },
 {
  "start": 7.39,
  "end": 8.22,
  "text": "มีกล่องให้ยืน"
 },
 {
  "start": 8.22,
  "end": 9.08,
  "text": "แต่ผู้กำกับ"
 },
 {
  "start": 9.08,
  "end": 9.66,
  "text": "อยากให้ภาพดู"
 },
 {
  "start": 9.66,
  "end": 10.58,
  "text": "สมจริงกว่านี้"
 },
 {
  "start": 10.58,
  "end": 11.58,
  "text": "เลยเอากล่องออก"
 },
 {
  "start": 11.58,
  "end": 12.08,
  "text": "ไมเคิลเลย"
 },
 {
  "start": 12.08,
  "end": 12.77,
  "text": "ต้องเอามือ"
 },
 {
  "start": 12.77,
  "end": 13.32,
  "text": "สอดไว้ระหว่าง"
 },
 {
  "start": 13.32,
  "end": 14.15,
  "text": "เชือกกับคอ"
 },
 {
  "start": 14.15,
  "end": 15.07,
  "text": "กันไม่ให้เชือกรัด"
 },
 {
  "start": 15.07,
  "end": 15.97,
  "text": "แต่มีเทคหนึ่ง"
 },
 {
  "start": 15.97,
  "end": 16.38,
  "text": "ที่มือเขา"
 },
 {
  "start": 16.38,
  "end": 17.17,
  "text": "วางผิดตำแหน่ง"
 },
 {
  "start": 17.17,
  "end": 17.7,
  "text": "เชือกเลยรัดคอ"
 },
 {
  "start": 17.7,
  "end": 18.26,
  "text": "จนหมดสติ"
 },
 {
  "start": 18.26,
  "end": 19.31,
  "text": "ไปจริงๆ"
 },
 {
  "start": 19.31,
  "end": 19.95,
  "text": "ที่น่ากลัวคือ"
 },
 {
  "start": 19.95,
  "end": 20.57,
  "text": "ทุกคนในกอง"
 },
 {
  "start": 20.57,
  "end": 21.34,
  "text": "นึกว่าเขาแสดง"
 },
 {
  "start": 21.34,
  "end": 21.87,
  "text": "สมจริงมาก"
 },
 {
  "start": 21.87,
  "end": 22.33,
  "text": "เขาห้อยอยู่"
 },
 {
  "start": 22.33,
  "end": 23.26,
  "text": "หลายวินาที"
 },
 {
  "start": 23.26,
  "end": 23.83,
  "text": "กว่าผู้กำกับ"
 },
 {
  "start": 23.83,
  "end": 24.19,
  "text": "จะรู้ว่า"
 },
 {
  "start": 24.19,
  "end": 25.28,
  "text": "นี่ไม่ใช่การแสดง"
 },
 {
  "start": 25.28,
  "end": 25.78,
  "text": "โชคดี"
 },
 {
  "start": 25.78,
  "end": 26.88,
  "text": "ที่ช่วยลงมาได้ทัน"
 },
 {
  "start": 26.88,
  "end": 27.36,
  "text": "และไมเคิล"
 },
 {
  "start": 27.36,
  "end": 27.71,
  "text": "เป็นคนเล่า"
 },
 {
  "start": 27.71,
  "end": 28.29,
  "text": "เรื่องนี้เอง"
 },
 {
  "start": 28.29,
  "end": 28.78,
  "text": "ในหนังสือ"
 },
 {
  "start": 28.78,
  "end": 29.59,
  "text": "ชีวประวัติ"
 },
 {
  "start": 29.59,
  "end": 30.04,
  "text": "ของเขา"
 }
]