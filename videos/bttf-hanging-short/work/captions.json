  "text": "ในฉากนี้"
 },
 {
  "start": 3.52,
  "end": 3.905,
  "text": "ในฉากนี้"
 },
 {
  "start": 3.905,
  "end": 4.29,
  "text": "มาร์ตี้ถูก"
 },
 {
  "start": 4.29,
  "end": 4.867,
  "text": "พวกคาวบอย"
 },
 {
  "start": 4.867,
  "end": 5.38,
  "text": "จับแขวนคอ"
 },
 {
  "start": 5.38,
  "end": 5.765,
  "text": "ตอนแรก"
 },
 {
  "start": 5.765,
  "end": 6.086,
  "text": "ไมเคิล"
 },
 {
  "start": 6.086,
  "end": 6.663,
  "text": "มีกล่องให้ยืน"
 },
 {
  "start": 6.663,
  "end": 7.112,
  "text": "แต่ผู้กำกับ"
 },
 {
  "start": 7.112,
  "end": 7.69,
  "text": "อยากให้ภาพ"
 },
 {
  "start": 7.69,
  "end": 8.331,
  "text": "ดูสมจริงกว่านี้"
 },
 {
  "start": 8.331,
  "end": 9.165,
  "text": "เลยเอากล่องออก"
 },
 {
  "start": 9.165,
  "end": 9.678,
  "text": "ไมเคิลเลย"
 },
 {
  "start": 9.678,
  "end": 10.191,
  "text": "ต้องเอามือ"
 },
 {
  "start": 10.191,
  "end": 10.897,
  "text": "สอดไว้ระหว่าง"
 },
 {
  "start": 10.897,
  "end": 11.41,
  "text": "เชือกกับคอ"
 },
 {
  "start": 11.41,
  "end": 12.18,
  "text": "กันไม่ให้เชือกรัด"
 },
 {
  "start": 12.18,
  "end": 12.943,
  "text": "แต่มีเทคหนึ่ง"
 },
 {
  "start": 12.943,
  "end": 13.452,
  "text": "ที่มือเขา"
 },
 {
  "start": 13.452,
  "end": 14.385,
  "text": "วางผิดตำแหน่ง"
 },
 {
  "start": 14.385,
  "end": 15.318,
  "text": "เชือกเลยรัดคอ"
 },
 {
  "start": 15.318,
  "end": 15.911,
  "text": "จนหมดสติ"
 },
 {
  "start": 15.911,
  "end": 16.42,
  "text": "ไปจริงๆ"
 },
 {
  "start": 16.42,
  "end": 16.989,
  "text": "ที่น่ากลัวคือ"
 },
 {
  "start": 16.989,
  "end": 17.629,
  "text": "ทุกคนในกอง"
 },
 {
  "start": 17.629,
  "end": 18.411,
  "text": "นึกว่าเขาแสดง"
 },
 {
  "start": 18.411,
  "end": 18.98,
  "text": "สมจริงมาก"
 },
 {
  "start": 18.98,
  "end": 19.558,
  "text": "เขาห้อยอยู่"
 },
 {
  "start": 19.558,
  "end": 20.136,
  "text": "หลายวินาที"
 },
 {
  "start": 20.136,
  "end": 20.714,
  "text": "กว่าผู้กำกับ"
 },
 {
  "start": 20.714,
  "end": 21.075,
  "text": "จะรู้ว่า"
 },
 {
  "start": 21.075,
  "end": 21.87,
  "text": "ไม่ใช่การแสดง"
 },
 {
  "start": 21.87,
  "end": 22.201,
  "text": "โชคดี"
 },
 {
  "start": 22.201,
  "end": 23.193,
  "text": "ที่ช่วยลงมาได้ทัน"
 },
 {
  "start": 23.193,
  "end": 23.854,
  "text": "และไมเคิล"
 },
 {
  "start": 23.854,
  "end": 24.515,
  "text": "เป็นคนเล่า"
 },
 {
  "start": 24.515,
  "end": 25.177,
  "text": "เรื่องนี้เอง"
 },
 {
  "start": 25.177,
  "end": 25.755,
  "text": "ในหนังสือ"
 },
 {
  "start": 25.755,
  "end": 26.334,
  "text": "ชีวประวัติ"
 },
 {
  "start": 26.334,
  "end": 26.83,
  "text": "ของเขา"
 }
