 },
 {
  "start": 13.48,
  "end": 13.95,
  "text": "วางผิดตำแหน่ง"
 },
 {
  "start": 13.95,
  "end": 14.84,
  "text": "เชือกเลยรัดคอ"
 },
 {
  "start": 14.84,
  "end": 15.45,
  "text": "จนหมดสติ"
 },
 {
  "start": 15.45,
  "end": 16.42,
  "text": "ไปจริงๆ"
 },
 {
  "start": 16.42,
  "end": 17.17,
  "text": "ที่น่ากลัวคือ"
 },
 {
  "start": 17.17,
  "end": 17.71,
  "text": "ทุกคนในกอง"
 },
 {
  "start": 17.71,
  "end": 18.56,
  "text": "นึกว่าเขาแสดง"
 },
 {
  "start": 18.56,
  "end": 18.98,
