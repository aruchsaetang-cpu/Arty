[
 {
  "start": 0.0,
  "end": 0.84,
  "text": "เพื่อนๆ รู้ไหมว่า"
 },
 {
  "start": 0.84,
  "end": 1.43,
  "text": "เลือดที่มือ"
 },
 {
  "start": 1.43,
  "end": 1.9,
  "text": "นักแสดง"
 },
 {
  "start": 1.9,
  "end": 2.55,
  "text": "ในฉากนี้"
 },
 {
  "start": 2.55,
  "end": 3.517,
  "text": "เป็นเลือดจริง!"
 },
 {
  "start": 3.517,
  "end": 3.81,
  "text": "ในหนัง"
 },
 {
  "start": 3.81,
  "end": 4.56,
  "text": "Django Unchained"
 },
 {
  "start": 4.56,
  "end": 5.97,
  "text": "ปี 2012"
 },
 {
  "start": 5.97,
  "end": 6.59,
  "text": "เขาเล่นเป็น"
 },
 {
  "start": 6.59,
  "end": 7.32,
  "text": "Calvin Candie"
 },
 {
  "start": 7.32,
  "end": 7.91,
  "text": "เจ้าของไร่"
 },
 {
  "start": 7.91,
  "end": 8.52,
  "text": "ผู้โหดร้าย"
 },
 {
  "start": 8.52,
  "end": 9.4,
  "text": "ในฉากโต๊ะอาหาร"
 },
 {
  "start": 9.4,
  "end": 10.25,
  "text": "ที่ตึงเครียดที่สุด"
 },
 {
  "start": 10.25,
  "end": 10.537,
  "text": "ของเรื่อง"
 },
 {
  "start": 10.537,
  "end": 11.78,
  "text": "เขาต้องตบโต๊ะ"
 },
 {
  "start": 11.78,
  "end": 12.387,
  "text": "ด้วยความโกรธ"
 },
 {
  "start": 12.387,
  "end": 13.357,
  "text": "ทุกคนในกอง"
 },
 {
  "start": 13.357,
  "end": 14.177,
  "text": "คิดว่าเป็นแค่"
 },
 {
  "start": 14.177,
  "end": 14.89,
  "text": "ฉากตบโต๊ะ"
 },
 {
  "start": 14.89,
  "end": 15.516,
  "text": "ธรรมดา"
 },
 {
  "start": 15.516,
  "end": 16.34,
  "text": "แต่มือของเขา"
 },
 {
  "start": 16.34,
  "end": 17.2,
  "text": "กลับฟาดลงบนแก้ว"
 },
 {
  "start": 17.2,
  "end": 17.68,
  "text": "จนแตก"
 },
 {
  "start": 17.68,
  "end": 18.15,
  "text": "และบาดมือ"
 },
 {
  "start": 18.15,
  "end": 18.66,
  "text": "จนเลือดไหล"
 },
 {
  "start": 18.66,
  "end": 19.797,
  "text": "ออกมาจริงๆ!"
 },
 {
  "start": 19.797,
  "end": 20.53,
  "text": "DiCaprio"
 },
 {
  "start": 20.53,
  "end": 21.42,
  "text": "ไม่หยุดเล่นเลย"
 },
 {
  "start": 21.42,
  "end": 22.35,
  "text": "เขาเล่นต่อไป"
 },
 {
  "start": 22.35,
  "end": 22.88,
  "text": "ทั้งที่เลือด"
 },
 {
  "start": 22.88,
  "end": 23.48,
  "text": "ไหลเต็มมือ"
 },
 {
  "start": 23.48,
  "end": 24.31,
  "text": "แถมยังเอามือ"
 },
 {
  "start": 24.31,
  "end": 24.77,
  "text": "เปื้อนเลือด"
 },
 {
  "start": 24.77,
  "end": 25.31,
  "text": "ไปป้ายหน้า"
 },
 {
  "start": 25.31,
  "end": 25.88,
  "text": "นักแสดงหญิง"
 },
 {
  "start": 25.88,
  "end": 26.735,
  "text": "อีกด้วย"
 },
 {
  "start": 26.735,
  "end": 27.34,
  "text": "ที่พีคคือ"
 },
 {
  "start": 27.34,
  "end": 28.005,
  "text": "ผู้กำกับ"
 },
 {
  "start": 28.005,
  "end": 28.82,
  "text": "Tarantino"
 },
 {
  "start": 28.82,
  "end": 29.515,
  "text": "ชอบเทคนี้มาก"
 },
 {
  "start": 29.515,
  "end": 30.89,
  "text": "จนเก็บไว้ในหนัง"
 },
 {
  "start": 30.89,
  "end": 31.54,
  "text": "ให้เราเห็น"
 },
 {
  "start": 31.54,
  "end": 32.691,
  "text": "จนถึงทุกวันนี้!"
 }
