[
 {
  "start": 0.0,
  "text": "เพื่อนๆ รู้มั้ยว่า",
  "end": 1.25
 },
 {
  "start": 1.25,
  "text": "ฉากอินดี้ยิงนักดาบทิ้ง",
  "end": 2.78
 },
 {
  "start": 2.78,
  "text": "ใน Indiana Jones",
  "end": 4.32
 },
 {
  "start": 4.32,
  "text": "ไม่ได้อยู่ในบท!",
  "end": 5.51
 },
 {
  "start": 5.51,
  "text": "ในบทเดิม",
  "end": 6.36
 },
 {
  "start": 6.36,
  "text": "อินดี้ต้องสู้ด้วยแส้",
  "end": 8.26
 },
 {
  "start": 8.26,
  "text": "ฉากต่อสู้ยาวหลายหน้า",
  "end": 10.11
 },
 {
  "start": 10.11,
  "text": "แต่วันถ่ายจริง",
  "end": 11.03
 },
 {
  "start": 11.03,
  "text": "ฟอร์ดท้องเสียหนัก",
  "end": 12.64
 },
 {
  "start": 12.64,
  "text": "จนแทบยืนไม่ไหว",
  "end": 14.33
 },
 {
  "start": 14.33,
  "text": "เขาเลยขอสปีลเบิร์กว่า",
  "end": 15.87
 },
 {
  "start": 15.87,
  "text": "ยิงทิ้งไปเลยไหม?",
  "end": 17.38
 },
 {
  "start": 17.38,
  "text": "ฉากนี้เลยกลายเป็น",
  "end": 19.07
 },
 {
  "start": 19.07,
  "text": "ฉากที่ฮาที่สุดของเรื่อง!",
  "end": 20.81
 }
]