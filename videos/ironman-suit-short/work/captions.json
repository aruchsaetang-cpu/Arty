[
 {
  "start": 0.0,
  "end": 0.8,
  "text": "เพื่อนๆ รู้ไหมว่า"
 },
 {
  "start": 0.8,
  "end": 1.37,
  "text": "ชุด Iron Man"
 },
 {
  "start": 1.37,
  "end": 2.07,
  "text": "ที่เห็นในหนัง"
 },
 {
  "start": 2.07,
  "end": 2.44,
  "text": "ส่วนใหญ่"
 },
 {
  "start": 2.44,
  "end": 3.478,
  "text": "ไม่มีอยู่จริง!"
 },
 {
  "start": 3.478,
  "end": 4.38,
  "text": "ตอนทำ Iron Man"
 },
 {
  "start": 4.38,
  "end": 4.72,
  "text": "ภาคแรก"
 },
 {
  "start": 4.72,
  "end": 6.07,
  "text": "ในปี 2008"
 },
 {
  "start": 6.07,
  "end": 6.72,
  "text": "ทีมงานสร้าง"
 },
 {
  "start": 6.72,
  "end": 7.37,
  "text": "ชุดเกราะเหล็ก"
 },
 {
  "start": 7.37,
  "end": 8.1,
  "text": "ของจริงขึ้นมา"
 },
 {
  "start": 8.1,
  "end": 8.888,
  "text": "ให้ใส่เข้าฉาก"
 },
 {
  "start": 8.888,
  "end": 9.23,
  "text": "ทั้งหนัก"
 },
 {
  "start": 9.23,
  "end": 9.86,
  "text": "ทั้งอึดอัด"
 },
 {
  "start": 9.86,
  "end": 10.398,
  "text": "จนใส่ได้"
 },
 {
  "start": 10.398,
  "end": 10.88,
  "text": "ไม่นาน"
 },
 {
  "start": 10.88,
  "end": 11.84,
  "text": "คนดูเลยคิดว่า"
 },
 {
  "start": 11.84,
  "end": 12.4,
  "text": "ทุกภาค"
 },
 {
  "start": 12.4,
  "end": 13.06,
  "text": "หลังจากนั้น"
 },
 {
  "start": 13.06,
  "end": 14.11,
  "text": "Robert Downey Jr."
 },
 {
  "start": 14.11,
  "end": 14.86,
  "text": "ก็ใส่ชุดเกราะ"
 },
 {
  "start": 14.86,
  "end": 15.991,
  "text": "เข้าฉากจริงๆ"
 },
 {
  "start": 15.991,
  "end": 16.79,
  "text": "แต่ยิ่งภาคหลังๆ"
 },
 {
  "start": 16.79,
  "end": 17.28,
  "text": "ชุดเกราะ"
 },
 {
  "start": 17.28,
  "end": 17.901,
  "text": "ที่เราเห็น"
 },
 {
  "start": 17.901,
  "end": 18.71,
  "text": "เกือบทั้งหมด"
 },
 {
  "start": 18.71,
  "end": 20.143,
  "text": "คือ CG!"
 },
 {
  "start": 20.143,
  "end": 20.723,
  "text": "ในกองถ่าย"
 },
 {
  "start": 20.723,
  "end": 21.37,
  "text": "เขามักใส่"
 },
 {
  "start": 21.37,
  "end": 22.283,
  "text": "แค่ชุดสีเทา"
 },
 {
  "start": 22.283,
  "end": 23.16,
  "text": "ที่มีจุด"
 },
 {
  "start": 23.16,
  "end": 23.49,
  "text": "ไว้จับ"
 },
 {
  "start": 23.49,
  "end": 24.26,
  "text": "การเคลื่อนไหว"
 },
 {
  "start": 24.26,
  "end": 24.81,
  "text": "บางฉาก"
 },
 {
  "start": 24.81,
  "end": 25.723,
  "text": "ใส่แค่ครึ่งตัว"
 },
 {
  "start": 25.723,
  "end": 26.52,
  "text": "หรือแค่ถุงมือ"
 },
 {
  "start": 26.52,
  "end": 27.263,
  "text": "แล้วทีมเอฟเฟกต์"
 },
 {
  "start": 27.263,
  "end": 28.24,
  "text": "ค่อยใส่ชุดเกราะ"
 },
 {
  "start": 28.24,
  "end": 29.27,
  "text": "ทับลงไปทีหลัง"
 },
 {
  "start": 29.27,
  "end": 29.7,
  "text": "ที่พีคคือ"
 },
 {
  "start": 29.7,
  "end": 30.7,
  "text": "ชุดที่ดูเหมือน"
 },
 {
  "start": 30.7,
  "end": 31.01,
  "text": "เหล็กจริง"
 },
 {
  "start": 31.01,
  "end": 31.813,
  "text": "จนคนทั้งโลกเชื่อ"
 },
 {
  "start": 31.813,
  "end": 32.453,
  "text": "จริงๆ แล้ว"
 },
 {
  "start": 32.453,
  "end": 32.823,
  "text": "สร้างขึ้น"
 },
 {
  "start": 32.823,
  "end": 33.85,
  "text": "ในคอมพิวเตอร์"
 },
 {
  "start": 33.85,
  "end": 34.36,
  "text": "ทั้งหมด!"
 }
]