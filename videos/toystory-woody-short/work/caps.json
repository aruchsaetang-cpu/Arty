[
 {
  "start": 0.0,
  "text": "เพื่อนๆ รู้มั้ยว่า",
  "end": 1.24
 },
 {
  "start": 1.24,
  "text": "วู้ดดี้เวอร์ชันแรก",
  "end": 3.43
 },
 {
  "start": 3.43,
  "text": "นิสัยแย่จนเกือบไม่ได้ฉาย!",
  "end": 5.52
 },
 {
  "start": 5.52,
  "text": "ปี 1993",
  "end": 7.49
 },
 {
  "start": 7.49,
  "text": "พิกซาร์ฉายฉบับร่างให้ดิสนีย์ดู",
  "end": 9.72
 },
 {
  "start": 9.72,
  "text": "วู้ดดี้เวอร์ชันนั้น",
  "end": 11.15
 },
 {
  "start": 11.15,
  "text": "ทั้งเห็นแก่ตัว",
  "end": 12.13
 },
 {
  "start": 12.13,
  "text": "ทั้งตะคอกใส่เพื่อน",
  "end": 13.6
 },
 {
  "start": 13.6,
  "text": "แต่ผู้บริหารรับไม่ได้",
  "end": 14.9
 },
 {
  "start": 14.9,
  "text": "ดิสนีย์สั่งหยุดการสร้าง!",
  "end": 16.86
 },
 {
  "start": 16.86,
  "text": "พิกซาร์เลยเขียนบทใหม่",
  "end": 18.44
 },
 {
  "start": 18.44,
  "text": "กลายเป็นวู้ดดี้ใจดี",
  "end": 20.1
 },
 {
  "start": 20.1,
  "text": "ที่เรารักทุกวันนี้",
  "end": 21.33
 }
]