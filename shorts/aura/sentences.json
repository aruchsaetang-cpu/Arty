[
 {
  "beat": "hook",
  "text": "It had rained in Sol for nine years.",
  "start": 0.3,
  "end": 2.33
 },
 {
  "beat": "hook",
  "text": "One man never got wet.",
  "start": 3.086,
  "end": 4.606
 },
 {
  "beat": "name",
  "text": "They called him Aura Monster.",
  "start": 5.36,
  "end": 6.87
 },
 {
  "beat": "name",
  "text": "Midnight. No umbrella. Bone dry.",
  "start": 7.522,
  "end": 9.702
 },
 {
  "beat": "theory",
  "text": "The shopkeepers said luck.",
  "start": 10.638,
  "end": 11.868
 },
 {
  "beat": "theory",
  "text": "The police said a trick.",
  "start": 12.364,
  "end": 13.454
 },
 {
  "beat": "theory",
  "text": "The kids said magic.",
  "start": 13.922,
  "end": 15.052
 },
 {
  "beat": "follow",
  "text": "So one night, I followed him into the alleys.",
  "start": 15.778,
  "end": 18.238
 },
 {
  "beat": "follow",
  "text": "Then I saw it.",
  "start": 19.13,
  "end": 19.96
 },
 {
  "beat": "reveal",
  "text": "He wasn't stopping the rain. He was dodging it.",
  "start": 20.676,
  "end": 23.166
 },
 {
  "beat": "reveal",
  "text": "Every drop. Too fast for the storm to touch him.",
  "start": 24.014,
  "end": 26.844
 },
 {
  "beat": "turn",
  "text": "He turned.",
  "start": 27.96,
  "end": 28.67
 },
 {
  "beat": "turn",
  "text": "\"You'll catch a cold, kid.\"",
  "start": 29.112,
  "end": 30.462
 },
 {
  "beat": "turn",
  "text": "\"Teach me,\" I said.",
  "start": 31.132,
  "end": 32.192
 },
 {
  "beat": "train",
  "text": "So he did. Every night, in the rain.",
  "start": 32.904,
  "end": 34.874
 },
 {
  "beat": "train",
  "text": "I held my umbrella. I couldn't dodge yet.",
  "start": 35.568,
  "end": 38.018
 },
 {
  "beat": "train",
  "text": "A hundred nights. A thousand drops.",
  "start": 38.858,
  "end": 41.158
 },
 {
  "beat": "close",
  "text": "Then one night, I closed it.",
  "start": 42.118,
  "end": 43.568
 },
 {
  "beat": "payoff",
  "text": "Now there are two of us.",
  "start": 44.408,
  "end": 45.598
 },
 {
  "beat": "payoff",
  "text": "And we never get wet.",
  "start": 46.186,
  "end": 47.306
 }
]