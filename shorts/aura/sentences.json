[
 {
  "beat": "hook",
  "text": "It had rained in Sol for nine years.",
  "start": 0.3,
  "end": 3.353
 },
 {
  "beat": "hook",
  "text": "One man never got wet.",
  "start": 3.603,
  "end": 5.208
 },
 {
  "beat": "name",
  "text": "They called him Aura Monster.",
  "start": 5.458,
  "end": 7.158
 },
 {
  "beat": "name",
  "text": "Midnight. No umbrella. Bone dry.",
  "start": 7.408,
  "end": 9.9
 },
 {
  "beat": "theory",
  "text": "The shopkeepers said luck.",
  "start": 10.15,
  "end": 11.393
 },
 {
  "beat": "theory",
  "text": "The police said a trick.",
  "start": 11.643,
  "end": 12.98
 },
 {
  "beat": "theory",
  "text": "The kids said magic.",
  "start": 13.23,
  "end": 14.663
 },
 {
  "beat": "follow",
  "text": "So one night, I followed him into the alleys.",
  "start": 14.913,
  "end": 17.055
 },
 {
  "beat": "follow",
  "text": "Then I saw it.",
  "start": 17.305,
  "end": 18.005
 },
 {
  "beat": "reveal",
  "text": "He wasn't stopping the rain. He was dodging it.",
  "start": 18.255,
  "end": 20.545
 },
 {
  "beat": "reveal",
  "text": "Every drop. Too fast for the storm to touch him.",
  "start": 20.795,
  "end": 22.895
 },
 {
  "beat": "turn",
  "text": "He turned.",
  "start": 23.145,
  "end": 23.66
 },
 {
  "beat": "turn",
  "text": "\"You'll catch a cold, kid.\"",
  "start": 23.91,
  "end": 25.412
 },
 {
  "beat": "turn",
  "text": "\"Teach me,\" I said.",
  "start": 25.662,
  "end": 26.682
 },
 {
  "beat": "train",
  "text": "So he did. Every night, in the rain.",
  "start": 26.932,
  "end": 28.738
 },
 {
  "beat": "train",
  "text": "I held my umbrella. I couldn't dodge yet.",
  "start": 28.988,
  "end": 30.873
 },
 {
  "beat": "train",
  "text": "A hundred nights. A thousand drops.",
  "start": 31.123,
  "end": 33.143
 },
 {
  "beat": "close",
  "text": "Then one night, I closed it.",
  "start": 33.393,
  "end": 34.653
 },
 {
  "beat": "payoff",
  "text": "Now there are two of us.",
  "start": 34.903,
  "end": 36.109
 },
 {
  "beat": "payoff",
  "text": "And we never get wet.",
  "start": 36.359,
  "end": 37.759
 }
]